{
  "info": {
    "name": "Digital Dean — practice 05 (SQLite accounts)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Локальна послідовність лише для 127.0.0.1 і синтетичних одноразових облікових даних. Запускати з початку: кроки створюють власні логіни й запам'ятовують лише свої id."
  },
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const s = Date.now().toString();",
              "pm.collectionVariables.set(\"inactive_login\", \"pm_inactive_\" + s);",
              "pm.collectionVariables.set(\"active_login\", \"pm_active_\" + s);",
              "pm.collectionVariables.set(\"other_login\", \"pm_other_\" + s);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register inactive (default status)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Навчальний користувач\",\n  \"email\": \"{{inactive_login}}@example.com\",\n  \"login\": \"{{inactive_login}}\",\n  \"password\": \"Learning only 05!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"safe created user\", () => {",
              "  pm.response.to.have.status(201);",
              "  const b = pm.response.json();",
              "  pm.expect(Object.keys(b).sort()).to.eql([\"email\", \"id\", \"login\", \"name\", \"status_id\"]);",
              "  pm.expect(Number.isInteger(b.id)).to.eql(true);",
              "  pm.expect(b.id).to.be.above(0);",
              "  pm.expect(b.status_id).to.eql(0);",
              "  pm.collectionVariables.set(\"inactive_user_id\", String(b.id));",
              "});"
            ]
          }
        }
      ]
    },
