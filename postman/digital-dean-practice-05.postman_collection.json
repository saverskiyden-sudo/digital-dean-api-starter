          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"no input echo\", () => {",
              "  pm.expect(pm.response.text()).to.not.include(\"Learning only 05!\");",
              "  pm.response.json().detail.forEach(d => { pm.expect(d).to.not.have.property(\"input\"); pm.expect(d).to.not.have.property(\"ctx\"); });",
              "});"
            ]
          }
        }
      ]
