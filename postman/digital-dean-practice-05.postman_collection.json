              "pm.test(\"blocked, same id\", () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b.status_id).to.eql(2);",
              "  pm.expect(String(b.id)).to.eql(pm.collectionVariables.get(\"active_user_id\"));",
              "  pm.expect(Object.keys(b).sort()).to.eql([\"email\", \"id\", \"login\", \"name\", \"status_id\"]);",
              "});"
            ]
          }
        }
