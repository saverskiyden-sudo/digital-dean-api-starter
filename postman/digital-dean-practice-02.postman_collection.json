{
  "info": {
    "_postman_id": "dc000002-0000-4000-8000-000000000002",
    "name": "Digital Dean — Practice 02",
    "description": "Запускайте запити послідовно (Runner) проти локального сервера: python -m uvicorn app.main:app --host 127.0.0.1. Усі дані вигадані. Варіант 1: поле category (general, academic, administrative) входить до запиту, відповіді, конверта й AAD. Крок 10 потребує створеного локально results/practice-02/report.json. Пошкодження серверного конверта перевіряється автоматизованими тестами, а не відкритим HTTP-маршрутом.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "student_id",
      "value": ""
    },
    {
      "key": "other_student_id",
      "value": ""
    },
    {
      "key": "note_id",
      "value": ""
    },
    {
      "key": "note_text",
      "value": "  Навчальна примітка про індивідуальний план  "
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('service is ready', () => pm.expect(pm.response.json()).to.eql({status: 'ok'}));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create synthetic student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Олена Коваль\",\n  \"email\": \"practice02-main-{{$guid}}@example.com\",\n  \"group_code\": \"КН-31\",\n  \"enrollment_year\": 2024\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('student_id', '');",
              "pm.collectionVariables.set('other_student_id', '');",
              "pm.collectionVariables.set('note_id', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.test('enrollment_year of work 1 is kept', () => pm.expect(pm.response.json().enrollment_year).to.eql(2024));",
              "if (pm.response.code === 201) pm.collectionVariables.set('student_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create protected note (category academic)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"{{note_text}}\",\n  \"category\": \"academic\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('student_id')) throw new Error('Create student first');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('note metadata without internal fields', () => {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.id).to.be.a('string');",
              "  pm.expect(body.student_id).to.eql(pm.collectionVariables.get('student_id'));",
              "  pm.expect(body.algorithm).to.eql('AES-256-GCM');",
              "  pm.expect(body.category).to.eql('academic');",
              "  pm.expect(body).not.to.have.property('text');",
              "  ['key', 'key_id', 'nonce', 'ciphertext', 'tag', 'backend'].forEach(field => pm.expect(body).not.to.have.property(field));",
              "});",
              "if (pm.response.code === 201) pm.collectionVariables.set('note_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Read verified note",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes/{{note_id}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('note_id')) throw new Error('Create note first');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('verified text and category are preserved exactly', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.id).to.eql(pm.collectionVariables.get('note_id'));",
              "  pm.expect(body.student_id).to.eql(pm.collectionVariables.get('student_id'));",
              "  pm.expect(body.text).to.eql(pm.collectionVariables.get('note_text'));",
              "  pm.expect(body.category).to.eql('academic');",
              "  ['key', 'key_id', 'nonce', 'ciphertext', 'tag', 'backend'].forEach(field => pm.expect(body).not.to.have.property(field));",
              "});"
            ]
          }
        }
      ]
    },
