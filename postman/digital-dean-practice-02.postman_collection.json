    {
      "name": "09 Read note through another student",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/students/{{other_student_id}}/secure-notes/{{note_id}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('other_student_id') || !pm.collectionVariables.get('note_id')) throw new Error('Run steps 02-08 first');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('foreign note is not found', () => pm.response.to.have.status(404));",
              "pm.test('no note text is leaked', () => pm.expect(pm.response.text()).not.to.include('Навчальна'));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Read benchmark report",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/lab/crypto/benchmark-results"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('report is available', () => pm.response.to.have.status(200));",
              "pm.test('report structure and 36 results', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.schema_version).to.eql(1);",
              "  pm.expect(body.run_id).to.be.a('string');",
              "  pm.expect(body.environment).to.be.an('object');",
              "  pm.expect(body.parameters.sizes_bytes).to.eql([1024, 65536, 1048576]);",
              "  pm.expect(body.parameters.warmup).to.eql(10);",
              "  pm.expect(body.parameters.series).to.eql(5);",
              "  pm.expect(body.parameters.operations_per_series).to.eql(100);",
              "  pm.expect(body.results).to.have.lengthOf(36);",
              "  body.results.forEach(row => pm.expect(row.series_mean_ns).to.have.lengthOf(5));",
              "});"
            ]
          }
        }
      ]
    },
